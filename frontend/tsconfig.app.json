{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    "paths": {
      // `tsc` takes the longest matching key, so these three need no ordering care. Vite's
      // aliases do, and vite.config.ts says why.
      "@/design-system": ["./design-system/index.ts"],
      "@/design-system/*": ["./design-system/*"],
      "@/*": ["./src/*"]
    }
  },
  // `design-system/` is compiled with the app, not beside it (`DEC-21`). `allowJs` is off, so
  // this picks up the TypeScript the conversion produces and ignores the `.jsx` still waiting
  // for it -- which is what lets `UI-1d` through `UI-1h` land one family folder at a time.
  "include": ["src", "design-system"],
  // `*.node.test.ts` is a test that reads the repository rather than the DOM -- the tokens are
  // self-hosted, no component contains a colour -- and it needs `node:fs`, which this project
  // deliberately cannot see. Giving the browser half of the codebase Node's globals so that a
  // handful of tests can call `readFileSync` is how `process.env` ends up inside a component.
  // They belong to tsconfig.node.json, which names them.
  "exclude": ["src/**/*.node.test.ts"]
}
