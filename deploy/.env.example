# Sonarium -- instance configuration (OPS-2, OPS-3).
#
# Every setting is read from the environment with the SONARIUM_ prefix, and nothing is read from a
# file inside the image. An instance is therefore fully described by this file plus its compose
# file, which is what makes it reproducible and what makes a backup of those two things enough to
# rebuild it.
#
# Copy this to `.env` beside your compose file and edit. Everything here is shown at its default
# except SONARIUM_SECRET_KEY, which has no default on purpose.

# --- Required --------------------------------------------------------------

# Signs the short-lived tokens that let the browser stream audio. Generate one with:
#
#     openssl rand -hex 32
#
# Changing it invalidates playback links that are already open; it does not sign sessions, so
# nobody is signed out. There is no default because a shipped default is the same as no secret.
SONARIUM_SECRET_KEY=

# Where transcription happens. Nothing can be transcribed until this is set, and getting it wrong
# is the most likely first-run failure -- it must end in /v1.
#
# The reference deployment is a local faster-whisper behind an OpenAI-compatible server, which is
# what the commented-out service in docker-compose.yml runs. On that path the audio never leaves
# your hardware.
SONARIUM_TRANSCRIPTION_BASE_URL=http://whisper:8000/v1

# --- A note on where your audio goes ---------------------------------------
#
# Principle 2 of this project is that your voice does not leave unless you ask. Sonarium sends
# audio to whatever the setting above names, and only when a transcription is requested.
#
# If you point it at a hosted endpoint, your recordings are uploaded to that company. That is a
# legitimate thing to choose and the interface says so before each request -- but it is a choice,
# and this is the setting that makes it. Nothing makes that choice on your behalf: every request
# comes from somebody pressing transcribe, and this version has no standing configuration that
# sends audio anywhere on its own.

# SONARIUM_TRANSCRIPTION_API_KEY=
# SONARIUM_TRANSCRIPTION_MODEL=whisper-1
# Instance default language. Leave unset for auto-detect; a request can always override it.
# SONARIUM_TRANSCRIPTION_LANGUAGE=
# The request ceiling long recordings are split to fit. 25 MB is the hosted limit.
# SONARIUM_TRANSCRIPTION_REQUEST_MAX_BYTES=26214400
# SONARIUM_TRANSCRIPTION_MAX_PART_SECONDS=600
# SONARIUM_TRANSCRIPTION_OVERLAP_SECONDS=3.0
# SONARIUM_TRANSCRIPTION_TIMEOUT_SECONDS=900.0
# SONARIUM_TRANSCRIPTION_PROVIDER=openai-compatible

# --- Where things live -----------------------------------------------------

# Everything mutable: the database, the storage tree, temporary files. This is the path the
# named volume is mounted at, and the only thing that has to be backed up.
# SONARIUM_DATA_DIR=/data
# Override only to put them somewhere else; both default to under SONARIUM_DATA_DIR.
# SONARIUM_DATABASE_PATH=/data/sonarium.db
# SONARIUM_STORAGE_DIR=/data/storage

# --- Deployment ------------------------------------------------------------

# Empty for a subdomain (sonarium.example.org). Set to a path for a subpath
# (example.org/sonarium). Both are supported and both are tested; see deploy/README.md.
# SONARIUM_BASE_PATH=

# The absolute URL the instance is reached on, when it needs to build one.
# SONARIUM_PUBLIC_URL=

# Whether the session cookie is marked Secure, which decides whether a browser keeps it at all:
# a Secure cookie that arrives over plain HTTP is discarded silently, and the person is returned
# to the sign-in screen as though the password were wrong.
#   auto   the connection decides -- marked when the request came over HTTPS. Works whether the
#          instance is reached through a TLS proxy, on a LAN address, or both.
#   true   always marked, and signing in over plain HTTP is refused with a message instead of
#          being accepted and then dropped. For an instance that is HTTPS and only HTTPS.
#   false  never marked. For an instance that is plain HTTP on purpose.
# `auto` reads X-Forwarded-Proto from any proxy on a loopback, link-local or private address, so a
# proxy in a container network needs nothing set. A proxy on a public address needs uvicorn's
# --forwarded-allow-ips, which is the same flag that makes session addresses accurate.
# SONARIUM_SESSION_COOKIE_SECURE=auto

# SONARIUM_SESSION_TTL_DAYS=30
# SONARIUM_SESSION_COOKIE_NAME=sonarium_session
# Per address AND client together, per minute. Enough that nobody notices; too few to grind a
# password list. Both halves of that key matter: counting the address alone would let anybody who
# knows an address lock its owner out from anywhere.
# SONARIUM_LOGIN_ATTEMPTS_PER_MINUTE=10

# The second ceiling: one client, whatever addresses it names. Higher than the per-account one
# because a household behind one address is ordinary and a few wrong passwords at once must not
# lock the door -- low enough that walking an address list from one place is not worth starting.
# SONARIUM_LOGIN_ATTEMPTS_PER_CLIENT_PER_MINUTE=60

# debug | info | warning | error
# SONARIUM_LOG_LEVEL=info
# json for a deployed instance, console for a person reading along.
# SONARIUM_LOG_FORMAT=json

# --- Retention and ingestion -----------------------------------------------

# How long the trash keeps things. Per instance, never per library.
# SONARIUM_TRASH_RETENTION_DAYS=30

# 8 GiB. A multi-hour interview at a high bitrate can approach this.
# SONARIUM_MAX_UPLOAD_BYTES=8589934592

# The ceiling on every request that is not an upload, enforced before the body is read. A sign-in
# is a few hundred bytes, so 1 MiB is generous; it is here so that nobody who is not signed in can
# spend this instance's disk describing a body it would never have accepted.
# SONARIUM_MAX_REQUEST_BYTES=1048576

# Waveform resolution. Changing it does not invalidate stored waveforms -- they carry a format
# version and are recomputed on demand -- but it does mean new and old ones differ in detail.
# SONARIUM_WAVEFORM_PEAKS_PER_SECOND=10

# --- Jobs ------------------------------------------------------------------

# How many jobs run at once in this process. This is the knob for doing more work at once; the
# number of processes is not -- see "One process writes" in README.md.
# SONARIUM_JOB_CONCURRENCY=2

# How many transcriptions are sent to the engine at once, whatever the line above says. One,
# because a local server with one GPU does not go faster when asked for two -- it competes with
# itself for memory, and what that looks like from here is a recording that fails halfway. Raise
# it only for an engine you know serves several at a time, such as a hosted endpoint.
# SONARIUM_TRANSCRIPTION_CONCURRENCY=1

# Whether this process runs the worker. Setting it false stops jobs running here; it does not
# make it safe to run `sonarium work` elsewhere against the same database, which would be a
# second writer this one knows nothing about.
# SONARIUM_RUN_WORKER=true
